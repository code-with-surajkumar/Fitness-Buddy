# ============================================================
#  Fitness Buddy — Environment Configuration TEMPLATE
#  Copy this file to .env and fill in your real credentials
#  IBM Cloud + IBM Granite (watsonx.ai) credentials
# ============================================================

# ----------------------------------------------------------
# IBM Cloud / watsonx.ai Authentication
# Get these from: https://cloud.ibm.com/iam/apikeys
# and your watsonx.ai project at: https://dataplatform.cloud.ibm.com
# ----------------------------------------------------------

# IBM Cloud API Key (IAM authentication)
IBM_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Service URL (region-specific)
# e.g. https://us-south.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM watsonx.ai Project ID
# Found in: watsonx.ai → Manage → General → Project ID
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ----------------------------------------------------------
# IBM Granite Model Configuration
# ----------------------------------------------------------

# Primary Granite model for chat/reasoning
IBM_GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Fallback / instruction model
IBM_GRANITE_INSTRUCT_MODEL_ID=ibm/granite-13b-instruct-v2

# ----------------------------------------------------------
# IBM Watson Assistant (optional — for enhanced dialog)
# Get from: https://cloud.ibm.com/resources → Watson Assistant
# ----------------------------------------------------------
WATSON_ASSISTANT_API_KEY=your_watson_assistant_api_key_here
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=your_watson_assistant_id_here

# ----------------------------------------------------------
# Application Server Settings
# ----------------------------------------------------------
PORT=3000
NODE_ENV=development

# Session secret for cookie signing (change in production)
SESSION_SECRET=fitness_buddy_session_secret_change_in_prod

# CORS allowed origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------
# AI Generation Parameters (tuneable)
# ----------------------------------------------------------
AI_MAX_NEW_TOKENS=600
AI_TEMPERATURE=0.75
AI_TOP_P=0.9
AI_TOP_K=50
AI_REPETITION_PENALTY=1.1

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
